# iptv-radar 配置模板
# 复制为 .env 并填入你自己的真实值。.env 不会被提交到 git。
#
# ┌─────────────────────────────────────────────────────────────┐
# │ 如何获取这些值? 见 docs/mechanism/03_EPG认证与频道获取.md      │
# │ 简述: 抓包机顶盒开机过程,或从机顶盒设置页读取                  │
# └─────────────────────────────────────────────────────────────┘

# ==== EPG 认证凭证(必填,各人不同) ====
# EPG账号(16位数字),抓包DHCP/EPG请求可见
EPG_USERID=YOUR_USERID
# 机顶盒ID = 固定前缀 + 账号 + MAC,共32位
STB_ID=YOUR_STBID
# 机顶盒MAC(软路由需克隆此MAC做IPoE认证)
STB_MAC=AA:BB:CC:DD:EE:FF
# DES认证密钥(8位),抓包分析认证请求得到(本例为00000000)
DES_KEY=00000000
# 机顶盒型号/固件(抓包ValidAuthentication请求可见)
STB_TYPE=EC6108V9U_pub_zjzdx
STB_VERSION=V100R003C82LZJD11SPC002B012
# 区域ID(各地市不同,杭州=57104)
AREA_ID=57104

# ==== 服务器地址(各地区运营商不同,浙江示例) ====
EDS_SERVER=220.191.136.23:8082
EPG_SERVER=115.233.40.140:33200

# ==== 本地环境 ====
# msd_lite/udpxy/rtp2httpd 地址(组播转HTTP)
MSD=127.0.0.1:4088
# rtp2httpd FCC快速换台服务器 IP:端口(抓包获取,留空则m3u不加FCC参数)
FCC_SERVER=
# 软路由IP(部分脚本SSH用)
ROUTER_IP=192.168.1.1
# Nginx发布目录(m3u输出到这,供其他设备访问)
NGINX_M3U_DIR=/path/to/nginx/m3u

# ==== 孤儿源识别: 结果文件放回路径(只影响识别页面上显示的提示命令) ====
# 页面导出 resolved_*.json 后会提示怎么放回 data/orphan_inbox/。
# 不配也能用(显示占位符),配了就能直接一键复制、不用每次自己拼。
# scp 目标(user@host:绝对路径,注意末尾斜杠)
INBOX_SCP_TARGET=user@nas.example.com:/volume1/docker/iptv-radar/data/orphan_inbox/
# ssh 端口(默认22时留空)
INBOX_SSH_PORT=
# 已挂载(SMB/NFS)时的本地路径,留空则用默认 /Volumes/docker/... 形态
INBOX_LOCAL_PATH=

# ==== 容器运行身份(部署用) ====
# 镜像默认以非root(uid 1000)运行。若宿主挂载目录属主不是1000(群晖/飞牛常见),
# 在这里设成实际属主,否则容器写不进 data/ 与 output/。查法: ls -ln <挂载目录>
DOCKER_UID=1000
DOCKER_GID=1000
